{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "bugReports": {
      ".read": false,
      ".write": false,
      "$reportId": {
        // Create-only. `auth != null` is satisfied by a SILENT anonymous
        // session for reports filed from the sign-in screen (lib/firebase's
        // bugReportToken; anonymous auth enabled 2026-08-29, which is what
        // finally quiets Firebase's daily insecure-rules email). The caps
        // below stay - an anonymous session is free to mint, so size is
        // still the real defence. `transcript` is user-typed (5k is
        // generous); `state` is App.vue's bugSnapshot, a few hundred bytes.
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['transcript', 'createdAt']) && newData.child('transcript').isString() && newData.child('transcript').val().length > 0 && newData.child('transcript').val().length <= 5000 && (!newData.hasChild('state') || (newData.child('state').isString() && newData.child('state').val().length <= 10000))"
      }
    }
  }
}
